# ===================== ArqHub — variáveis de ambiente =====================
# Supabase ÚNICO: https://yknwdpyaevodvonvhadt.supabase.co
# (URL e anon key já estão no código em src/integrations/external-supabase/)

# --- Supabase (servidor — NUNCA expor no navegador) ---
EXTERNAL_SUPABASE_SERVICE_ROLE_KEY=

# --- Admins (e-mails separados por vírgula) ---
ADMIN_EMAILS=

# --- Mercado Pago ---
MERCADOPAGO_ACCESS_TOKEN=
MERCADOPAGO_PUBLIC_KEY=
MERCADOPAGO_WEBHOOK_SECRET=

# --- Web Push (PWA) ---
# A chave pública do navegador já está em src/lib/push-config.ts.
# Copie estes dois valores EXATAMENTE como estão nos Secrets da Lovable.
VAPID_PUBLIC_RAW=
VAPID_PRIVATE_JWK=

# --- E-mails transacionais (Resend — substitui a fila da Lovable) ---
RESEND_API_KEY=
EMAIL_FROM="ArqHub <noreply@arqhub.world>"
SITE_URL=https://arqhub.world
# Para onde vão as respostas dos e-mails (ex.: contato@arqhub.world)
EMAIL_REPLY_TO=

# --- IA: chat da Liw e base de conhecimento (substitui LOVABLE_API_KEY) ---
AI_API_KEY=
# Opcionais (padrão: API OpenAI-compatível do Google Gemini)
# AI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
# AI_CHAT_MODEL=gemini-2.5-flash
# AI_EMBEDDING_MODEL=gemini-embedding-001
